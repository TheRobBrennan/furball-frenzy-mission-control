# Deployment settings for the Oracle Cloud VM. Copy to .env.deploy (gitignored, never committed)
# and fill in. See docs/deployment/oracle-vm.md.

# Public IPv4 address of the VM, from the OCI Console (Compute > Instances).
# Not static by default, update it if the instance is ever stopped and started or recreated.
FURBALL_VM_IP=

# Public hostname the Cloudflare Tunnel serves, used by `npr deploy:status` to check the live URL.
FURBALL_PUBLIC_HOSTNAME=furball-frenzy.sploosh.ai

# Tunnel name and id. `npr deploy:tunnel` creates the tunnel and fills TUNNEL_ID in. The id is not
# a secret, the credentials file (infra/cloudflared/credentials.json, gitignored) is.
TUNNEL_NAME=furball-frenzy
TUNNEL_ID=
