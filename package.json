{
  "name": "furball-frenzy-mission-control",
  "version": "0.24.0",
  "private": true,
  "description": "Furball Frenzy: Mission Control, a web game for the 2026 NASA Space Apps Challenge",
  "license": "MIT",
  "scripts": {
    "start": "make up-d",
    "stop": "make down",
    "restart": "make down && make up-d",
    "build": "make build",
    "clean": "make clean",
    "logs": "make logs",
    "ps": "make ps",
    "test": "make test",
    "lint": "make lint",
    "dev:api": "cd apps/api && uv run uvicorn app.main:app --reload --port 8000",
    "dev:web": "cd apps/web && pnpm dev",
    "deploy:provision": "./scripts/deploy/provision-vm.sh",
    "deploy:tunnel": "./scripts/deploy/cloudflare-tunnel.sh",
    "deploy:sync": "./scripts/deploy/deploy-to-oracle.sh sync",
    "deploy": "./scripts/deploy/deploy-to-oracle.sh up",
    "deploy:status": "./scripts/deploy/deploy-to-oracle.sh status",
    "deploy:logs": "./scripts/deploy/deploy-to-oracle.sh logs",
    "deploy:stop": "./scripts/deploy/deploy-to-oracle.sh stop",
    "deploy:start": "./scripts/deploy/deploy-to-oracle.sh start",
    "deploy:restart": "./scripts/deploy/deploy-to-oracle.sh restart",
    "deploy:down": "./scripts/deploy/deploy-to-oracle.sh down",
    "deploy:frozen:tunnel": "DEPLOY_ENV_FILE=.env.deploy.nasa-2026 ./scripts/deploy/cloudflare-tunnel.sh",
    "deploy:frozen": "DEPLOY_ENV_FILE=.env.deploy.nasa-2026 ./scripts/deploy/deploy-to-oracle.sh up",
    "deploy:frozen:status": "DEPLOY_ENV_FILE=.env.deploy.nasa-2026 ./scripts/deploy/deploy-to-oracle.sh status",
    "deploy:frozen:freeze": "DEPLOY_ENV_FILE=.env.deploy.nasa-2026 ./scripts/deploy/deploy-to-oracle.sh freeze",
    "deploy:frozen:unfreeze": "DEPLOY_ENV_FILE=.env.deploy.nasa-2026 ./scripts/deploy/deploy-to-oracle.sh unfreeze"
  },
  "engines": {
    "node": ">=24.17.0 <25",
    "pnpm": ">=10.11"
  }
}
